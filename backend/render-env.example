# Copy these names into the FYC_Marketplace service in Render.
# Replace every placeholder. Never commit the completed values.
NODE_ENV=production
PORT=5001
DB_NAME=tut_marketplace
MONGODB_URI=replace-with-render-secret
JWT_SECRET=replace-with-at-least-32-random-characters
FRONTEND_URL=https://marketplace.lbgsoftware.co.za
CORS_ALLOWED_ORIGINS=https://marketplace.lbgsoftware.co.za

# Marketplace-only Resend key with Sending access, restricted to lbgsoftware.co.za.
RESEND_API_KEY=re_replace-with-marketplace-sending-key
EMAIL_FROM="FYC Marketplace <marketplace@lbgsoftware.co.za>"
EMAIL_REPLY_TO=support@firstyearcouncil.co.za
SUPPORT_EMAIL=support@firstyearcouncil.co.za
EMAIL_DELIVERY_DISABLED=false

PAYMENT_SERVICE_URL=https://lbg-payment-service.onrender.com
PAYMENT_SERVICE_KEY_ID=replace-with-marketplace-key-id
PAYMENT_SERVICE_SECRET=replace-with-render-secret
PAYMENT_SERVICE_CALLBACK_SECRET=replace-with-render-secret
